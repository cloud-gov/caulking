# Caulking profile: terraform
# Purpose: Terraform CLI and TFLint infrastructure linter.
# Minimum supported version floors are verified by `caulking doctor`,
# allowing users to run `brew upgrade` freely without exact version locks.
tap "hashicorp/tap"
tap "terraform-linters/tap"
brew "hashicorp/tap/terraform"
cask "terraform-linters/tap/tflint"
