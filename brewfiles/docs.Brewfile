# Caulking profile: docs
# Purpose: YAML, GitHub Actions workflow, and Markdown formatting, linting, and SAST tools.
# Minimum supported version floors are verified by `caulking doctor`,
# allowing users to run `brew upgrade` freely without exact version locks.
brew "yamllint"
brew "yamlfmt"
brew "actionlint"
brew "zizmor"
brew "markdownlint-cli"
